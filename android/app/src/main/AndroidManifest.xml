<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nur für die lokale Verbindung über USB (adb forward auf 127.0.0.1) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Webcam für den PC: nur die Frontkamera, nur auf Anforderung (Schalter am PC) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- „Nicht stören“ während des Monitorbetriebs (nur nach Einschalten am PC und
         einmaliger Erlaubnis in den Tablet-Einstellungen) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.USBCD">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Einstieg für den PC (adb shell am start …/.Connect). Nur die adb-Shell hat
             android.permission.DUMP – normale Apps können hier kein Geheimnis einschleusen. -->
        <activity-alias
            android:name=".Connect"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:targetActivity=".MainActivity" />
    </application>
</manifest>
